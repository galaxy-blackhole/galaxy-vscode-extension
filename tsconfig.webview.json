{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@webview/*": ["webview/src/*"],
      "@galaxy/*": ["src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["webview/src/**/*.ts", "webview/src/**/*.tsx", "src/protocol.ts"]
}
