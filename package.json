{
  "name": "galaxy-code-vscode",
  "displayName": "Galaxy Blackhole",
  "icon": "resources/icon.png",
  "description": "AI coding chat for VS Code with per-workspace sessions, project MCP servers, plan checklists and approvals, built on the Galaxy Blackhole core.",
  "version": "2.4.0",
  "private": true,
  "publisher": "kevinbui",
  "license": "MIT",
  "engines": {
    "vscode": "^1.113.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "galaxy-code-sidebar",
          "title": "Galaxy Blackhole",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "galaxy-code-sidebar": [
        {
          "id": "galaxy-code.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/icon.svg"
        },
        {
          "id": "galaxy-code.gbhSessions",
          "name": "GBH Kernel",
          "type": "tree",
          "icon": "resources/icon.svg"
        },
        {
          "id": "galaxy-code.gbhConversation",
          "name": "Hội thoại",
          "type": "webview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "galaxy-code.openChat",
        "title": "Galaxy Blackhole: Open Chat",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.newThread",
        "title": "Galaxy Blackhole: New Thread",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.openWeb",
        "title": "Galaxy Blackhole: Open Web GUI",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.refreshGbhSessions",
        "title": "Galaxy Blackhole: Refresh GBH Kernel Sessions",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.openGbhHome",
        "title": "Galaxy Blackhole: Show GBH Home",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.showGbhTranscript",
        "title": "Galaxy Blackhole: Show Session Transcript",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.showGbhDiff",
        "title": "Galaxy Blackhole: Show File Diff",
        "category": "Galaxy Blackhole"
      },
      {
        "command": "galaxy-code.newGbhSession",
        "title": "Galaxy Blackhole: New Session",
        "category": "Galaxy Blackhole",
        "icon": "$(add)"
      },
      {
        "command": "galaxy-code.cancelGbhRun",
        "title": "Galaxy Blackhole: Stop Running Turn",
        "category": "Galaxy Blackhole",
        "icon": "$(debug-stop)"
      },
      {
        "command": "galaxy-code.renameGbhSession",
        "title": "Galaxy Blackhole: Rename Session",
        "category": "Galaxy Blackhole",
        "icon": "$(edit)"
      },
      {
        "command": "galaxy-code.pinGbhSession",
        "title": "Galaxy Blackhole: Pin Session",
        "category": "Galaxy Blackhole",
        "icon": "$(pin)"
      },
      {
        "command": "galaxy-code.archiveGbhSession",
        "title": "Galaxy Blackhole: Archive Session",
        "category": "Galaxy Blackhole",
        "icon": "$(archive)"
      }
    ],
    "configuration": {
      "title": "Galaxy Blackhole",
      "properties": {
        "galaxy-code.cliPath": {
          "type": "string",
          "default": "blackhole",
          "markdownDescription": "Đường dẫn tới CLI  (mặc định: tìm trên PATH). Cài bằng ."
        },
        "galaxy-code.webPort": {
          "type": "number",
          "default": 3090,
          "markdownDescription": "Cổng cho Galaxy Blackhole web GUI (mặc định 3090)."
        },
        "galaxy-code.gbhHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "Thư mục home của kernel GBH (để trống = dùng GBH_HOME, rồi tới ~/.galaxy/blackhole)."
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "galaxy-code.openGbhSession",
          "when": "view == galaxy-code.gbhSessions && viewItem == gbhSession",
          "group": "inline"
        },
        {
          "command": "galaxy-code.cancelGbhRun",
          "when": "view == galaxy-code.gbhSessions && viewItem == gbhSession",
          "group": "inline@1"
        },
        {
          "command": "galaxy-code.renameGbhSession",
          "when": "view == galaxy-code.gbhSessions && viewItem == gbhSession",
          "group": "session@1"
        },
        {
          "command": "galaxy-code.pinGbhSession",
          "when": "view == galaxy-code.gbhSessions && viewItem == gbhSession",
          "group": "session@2"
        },
        {
          "command": "galaxy-code.archiveGbhSession",
          "when": "view == galaxy-code.gbhSessions && viewItem == gbhSession",
          "group": "session@3"
        }
      ],
      "view/title": [
        {
          "command": "galaxy-code.newGbhSession",
          "when": "view == galaxy-code.gbhSessions",
          "group": "navigation@1"
        },
        {
          "command": "galaxy-code.refreshGbhSessions",
          "when": "view == galaxy-code.gbhSessions",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "galaxy-code.showGbhTranscript",
        "key": "cmd+alt+g",
        "mac": "cmd+alt+g",
        "when": "workspaceFolderCount > 0"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js && vite build",
    "compile:production": "node esbuild.js --production && vite build",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "vite build --watch",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "test:webview": "node scripts/webview-smoke.mjs",
    "test:host": "node --import ./test/helpers/ts-resolve.mjs --test test/*.test.ts",
    "test:vscode": "yarn compile && node test/vscode/run.mjs",
    "vscode:prepublish": "yarn run package && yarn run resources:check",
    "package": "yarn run check-types && yarn run compile:production",
    "marketplace:login": "npx @vscode/vsce login kevinbui",
    "marketplace:package": "npx @vscode/vsce package",
    "marketplace:publish": "npx @vscode/vsce publish",
    "marketplace:publish:ci": "npx @vscode/vsce publish --pat $VSCE_PAT",
    "marketplace:publish:pre-release": "npx @vscode/vsce publish --pre-release",
    "marketplace:publish:pre-release:ci": "npx @vscode/vsce publish --pre-release --pat $VSCE_PAT",
    "resources:sync": "node scripts/sync-brand-assets.mjs",
    "resources:check": "node scripts/sync-brand-assets.mjs --check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "file:./vendor/dsh-client-ui-primitives",
    "@galaxy-stack/ai-coder-core": "link:../galaxy-ai-coder-core",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "immer": "^11.1.21",
    "katex": "^0.19.0",
    "mdast-util-math": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.20",
    "@assistant-ui/react-markdown": "0.14.15",
    "@types/node": "^22.19.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "^1.103.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-electron": "^3.1.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.3",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "https://github.com/galaxy-blackhole/galaxy-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/galaxy-blackhole/galaxy-vscode-extension/issues"
  },
  "homepage": "https://github.com/galaxy-blackhole/galaxy-vscode-extension#readme"
}
